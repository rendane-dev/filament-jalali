{
	"name": "rendane/filament-jalali",
	"description": "Jalali date support for Filament",
	"type": "library",
	"license": "MIT",
	"require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "hekmatinasser/verta": "^9.0"
    },
	"autoload": {
		"psr-4": {
			"Rendane\\FilamentJalali\\": "src/"
		}
	},
    "autoload-dev": {
        "psr-4": {
            "Rendane\\FilamentJalali\\Tests\\": "tests/"
        }
    },
	"extra": {
		"laravel": {
			"providers": [
				"Rendane\\FilamentJalali\\Providers\\FilamentJalaliServiceProvider"
			]
		}
	}
}
